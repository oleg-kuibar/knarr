{
  "name": "knarr",
  "version": "0.2.0",
  "description": "Copy local npm package builds into consumer node_modules with incremental sync and watch mode.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "knarr": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.mjs",
      "require": "./dist/vite-plugin.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack-plugin.d.ts",
      "import": "./dist/webpack-plugin.mjs",
      "require": "./dist/webpack-plugin.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite-plugin.d.ts"
      ],
      "webpack": [
        "./dist/webpack-plugin.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "compat:smoke": "node scripts/compat-smoke.mjs",
    "bench": "vitest bench --reporter=verbose",
    "lint": "tsc -p tsconfig.test.json && eslint .",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "npm",
    "link",
    "local",
    "development",
    "local-package",
    "yalc",
    "package",
    "monorepo",
    "pnpm",
    "react",
    "vite",
    "webpack",
    "nextjs",
    "yarn",
    "bun",
    "symlink",
    "copy"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleg-kuibar/knarr.git"
  },
  "homepage": "https://github.com/oleg-kuibar/knarr#readme",
  "bugs": {
    "url": "https://github.com/oleg-kuibar/knarr/issues"
  },
  "author": "Oleg Kuibar (https://github.com/oleg-kuibar)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@rspack/core": ">=0.5.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    }
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "xxhash-wasm": "^1.1.0"
  }
}
