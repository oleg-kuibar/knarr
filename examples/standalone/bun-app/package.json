{
  "name": "bun-app",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js/Bun consumer using bun",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "postinstall": "node -e \"try{require('./.knarr/restore.cjs')}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\"",
    "knarr:add": "knarr add @example/ui-kit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
