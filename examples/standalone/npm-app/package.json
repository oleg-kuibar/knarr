{
  "name": "npm-app",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js consumer using npm",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "postinstall": "node -e \"try{require('./.knarr/restore.cjs')}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\""
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  }
}
