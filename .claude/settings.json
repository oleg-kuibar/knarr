{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm bench *)",
      "Bash(pnpm compat:smoke)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(npx -y pnpm@* lint)",
      "Bash(npx -y pnpm@* build)",
      "Bash(npx -y pnpm@* test)",
      "Bash(npx -y pnpm@* vitest run *)",
      "Bash(npx -y pnpm@* install --frozen-lockfile)",
      "Bash(node dist/cli.mjs *)",
      "Bash(node scripts/verify-pack.mjs)",
      "Bash(npm view *)",
      "Bash(npm pack --dry-run)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh release view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo edit *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn add *)",
      "Bash(bun add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)",
      "Bash(yarn npm publish *)",
      "Bash(bun publish *)",
      "Bash(npm login *)",
      "Bash(npm token *)",
      "Bash(npm adduser *)",
      "Bash(gh auth token *)",
      "Bash(gh secret *)",
      "Bash(gh auth refresh *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --no-verify *)",
      "Bash(git config --global *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
